    "schemas": {
      "ApiIndex": {
        "type": "object",
        "description": "Self-describing index of the VeloRix public API.",
        "required": [
          "name",
          "version",
          "openapi",
          "endpoints"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "openapi": {
            "type": "string",
            "format": "uri"
          },
          "documentation": {
            "type": "string",
            "format": "uri"
          },
          "mcp": {
            "type": "string",
            "format": "uri"
          },
          "rate_limit": {
            "type": "object",
            "description": "Published quota for this API.",
            "properties": {
              "limit": {
                "type": "integer"
              },
              "window_seconds": {
                "type": "integer"
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "documentation": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "versioning": {
            "type": "object",
            "description": "Versioning and deprecation policy summary.",
            "properties": {
              "current": {
                "type": "string"
              },
              "scheme": {
                "type": "string"
              },
              "deprecation_signals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "minimum_support_window_days": {
                "type": "integer"
              },
              "policy": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "operationId",
                "method",
                "path"
              ],
              "properties": {
                "operationId": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageSummary": {
        "type": "object",
        "description": "Summary of a published VeloRix page.",
        "required": [
          "slug",
          "title"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Lowercase hyphenated identifier used in URLs."
          },
          "title": {
            "type": "string",
            "description": "Page title."
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional one-line subtitle."
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Last edit timestamp (UTC)."
          }
        }
      },
      "PageList": {
        "type": "object",
        "description": "List of published pages with the paging window that produced it.",
        "required": [
          "items",
          "count"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageSummary"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Page": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PageSummary"
          },
          {
            "type": "object",
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string",
                "description": "Full page body in Markdown."
              }
            }
          }
        ]
      },
      "ApkRelease": {
        "type": "object",
        "description": "An active VeloRix Android release.",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "Semantic version string, e.g. '1.4.2'."
          },
          "file_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Storage path of the APK object."
          },
          "file_size": {
            "type": [
              "integer",
              "null"
            ],
            "description": "APK size in bytes."
          },
          "changelog": {
            "type": [
              "string",
              "null"
            ],
            "description": "Release notes in Markdown."
          },
          "released_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "SiteStatus": {
        "type": "object",
        "description": "Live platform status.",
        "required": [
          "status",
          "maintenance",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "maintenance"
            ]
          },
          "maintenance": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Structured RFC 9457 problem document. Every non-2xx response uses this shape.",
        "required": [
          "status",
          "error",
          "title"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Link to documentation for this error code."
          },
          "title": {
            "type": "string",
            "description": "Short machine-readable error title (same as error.code)."
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation (mirrors error.message)."
          },
          "instance": {
            "type": "string",
            "description": "Path of the request that failed."
          },
          "error": {
            "type": "object",
            "description": "Machine-readable error payload.",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable error code.",
                "enum": [
                  "bad_request",
                  "page_not_found",
                  "no_active_release",
                  "endpoint_not_found",
                  "method_not_allowed",
                  "rate_limited",
                  "upstream_error",
                  "backend_unavailable",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation."
              },
              "hint": {
                "type": "string",
                "description": "How to resolve or recover from the error."
              },
              "retry_after": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Seconds to wait before retrying, when applicable."
              }
            }
          }
        }
      }
    }
  }
}
