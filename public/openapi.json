    "/status": {
      "get": {
        "operationId": "getSiteStatus",
        "tags": [
          "platform"
        ],
        "summary": "Get live platform status",
        "description": "Reports whether the VeloRix platform is live or in maintenance mode, with the operator's current status message. Call this before telling a player to register for a tournament.",
