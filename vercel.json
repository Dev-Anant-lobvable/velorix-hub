{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/mcp/:path*"
    },
    {
      "source": "/api/v1",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/public-api"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/public-api/:path*"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/.well-known/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/docs",
      "destination": "/developers/index.html"
    },
    {
      "source": "/api-docs",
      "destination": "/developers/index.html"
    },
    {
      "source": "/api/docs",
      "destination": "/developers/index.html"
    },
    {
      "source": "/developers",
      "destination": "/developers/index.html"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/api-catalog.json"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/help",
      "destination": "/index.html"
    },
    {
      "source": "/download",
      "destination": "/index.html"
    },
    {
      "source": "/status",
      "destination": "/index.html"
    },
    {
      "source": "/changelog",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/p/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/crew",
      "destination": "/index.html"
    },
    {
      "source": "/vx-control",
      "destination": "/index.html"
    },
    {
      "source": "/maintenance",
      "destination": "/index.html"
    },
    {
      "source": "/offline",
      "destination": "/index.html"
    },
    {
      "source": "/error/:code",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/md/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/404.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/.well-known/mcp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
