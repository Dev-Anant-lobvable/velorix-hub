{
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/public-api"
    },
    {
      "source": "/mcp.json",
      "destination": "/.well-known/mcp"
    },
    {
      "source": "/developers.md",
      "destination": "/md/developers.md"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/velorix-openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/mcp",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/mcp/:path*"
    },
    {
      "source": "/api/v1",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/public-api"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/public-api/:path*"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/.well-known/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/docs",
      "destination": "/developers/index.html"
    },
    {
      "source": "/api-docs",
      "destination": "/developers/index.html"
    },
    {
      "source": "/api/docs",
      "destination": "/developers/index.html"
    },
    {
      "source": "/developers",
      "destination": "/developers/index.html"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/api-catalog.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "RateLimit-Policy",
          "value": "\"static\";q=600;w=60, \"default\";q=120;w=60"
        },
        {
          "key": "RateLimit",
          "value": "\"static\";r=600;t=60"
        },
        {
          "key": "X-RateLimit-Limit",
          "value": "600"
        },
        {
          "key": "X-RateLimit-Remaining",
          "value": "600"
        },
        {
          "key": "X-RateLimit-Reset",
          "value": "60"
        },
        {
          "key": "X-API-Version",
          "value": "v1"
        },
        {
          "key": "Link",
          "value": "<https://velorix-hub.vercel.app/md/versioning.md>; rel=\"deprecation-policy\", <https://velorix-hub.vercel.app/openapi.json>; rel=\"service-desc\", <https://velorix-hub.vercel.app/.well-known/api-catalog>; rel=\"api-catalog\", <https://velorix-hub.vercel.app/llms.txt>; rel=\"help\""
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "RateLimit, RateLimit-Policy, Retry-After, X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset, X-API-Version, Link"
        }
      ]
    },
    {
      "source": "/md/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/404.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/.well-known/mcp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
