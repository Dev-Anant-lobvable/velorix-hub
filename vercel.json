{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://pvzoeafqfkwfgiiflaol.supabase.co/functions/v1/mcp/:path*"
    },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/download", "destination": "/index.html" },
    { "source": "/status", "destination": "/index.html" },
    { "source": "/changelog", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/p/:slug", "destination": "/index.html" },
    { "source": "/crew", "destination": "/index.html" },
    { "source": "/vx-control", "destination": "/index.html" },
    { "source": "/maintenance", "destination": "/index.html" },
    { "source": "/offline", "destination": "/index.html" },
    { "source": "/error/:code", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/md/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms-full.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/.well-known/mcp",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    }
  ]
}
